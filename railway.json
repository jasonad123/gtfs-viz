{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "src/**",
      "public/**",
      "scripts/**",
      "images/**",
      "extensions/**",
      "Caddyfile",
      "package.json",
      "yarn.lock",
      ".yarnrc",
      "railway.json",
      "railpack.json",
      "vite.config.ts",
      "tsconfig.json",
      "postcss.config.js",
      "tailwind.config.js"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
